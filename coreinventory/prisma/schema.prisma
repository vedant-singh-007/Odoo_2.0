generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String           @id @default(cuid())
  name         String
  loginId      String           @unique
  email        String           @unique
  phone        String?
  passwordHash String
  role         String           @default("STAFF") // MANAGER or STAFF
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  operations   StockOperation[]
}

model Location {
  id             String      @id @default(cuid())
  name           String
  type           String      // VENDOR, INTERNAL, CUSTOMER, VIRTUAL_LOSS
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  sourceMoves    StockMove[] @relation("SourceLocation")
  destMoves      StockMove[] @relation("DestLocation")
  reorderRules   ReorderRule[]
}

model Product {
  id            String      @id @default(cuid())
  name          String
  skuCode       String      @unique
  category      String      @default("General")
  unitOfMeasure String      @default("Units")
  reorderLevel  Int         @default(10)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  stockMoves    StockMove[]
  reorderRules  ReorderRule[]
}

model StockOperation {
  id          String      @id @default(cuid())
  type        String      // RECEIPT, DELIVERY, TRANSFER, ADJUSTMENT
  status      String      @default("DRAFT") // DRAFT, READY, DONE, CANCELLED
  reference   String?
  notes       String?
  createdBy   User        @relation(fields: [createdById], references: [id])
  createdById String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  moves       StockMove[]
}

model PasswordResetOtp {
  id        String   @id @default(cuid())
  email     String
  otp       String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model ReorderRule {
  id            String   @id @default(cuid())
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId     String
  location      Location @relation(fields: [locationId], references: [id])
  locationId    String
  minQuantity   Float    @default(0)
  maxQuantity   Float    @default(0)
  reorderPoint  Float    @default(10)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([productId, locationId])
}

model StockMove {
  id               String         @id @default(cuid())
  operation        StockOperation @relation(fields: [operationId], references: [id], onDelete: Cascade)
  operationId      String
  product          Product        @relation(fields: [productId], references: [id])
  productId        String
  sourceLocation   Location       @relation("SourceLocation", fields: [sourceLocationId], references: [id])
  sourceLocationId String
  destLocation     Location       @relation("DestLocation", fields: [destLocationId], references: [id])
  destLocationId   String
  quantity         Float
  createdAt        DateTime       @default(now())
}
